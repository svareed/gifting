# --- Required in production -------------------------------------------------
# Without these Davet refuses to start in production, because the fallback demo
# store keeps data in process memory and cannot survive serverless instances.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Recommended ------------------------------------------------------------
# Salts the hash used to count repeat submissions. Any long random string.
# Changing it resets abuse counters; it never affects stored invitations.
RATE_LIMIT_SALT=

# Shared secret for the daily keep-alive cron. Set it and Vercel sends it
# automatically; leave it empty and /api/keepalive is publicly callable.
CRON_SECRET=

# Reminder email. Without both of these the daily run still computes what is
# due — the dashboard shows it, ready to send on WhatsApp — it just cannot post
# anything itself. WhatsApp has no server-side send without the Business API,
# so it is click-to-send by design.
RESEND_API_KEY=
REMINDER_FROM=

# --- Optional ---------------------------------------------------------------
# Absolute origin for share links and OG images. On Vercel this is derived from
# VERCEL_PROJECT_PRODUCTION_URL, so it only needs setting for a custom domain.
NEXT_PUBLIC_SITE_URL=

# Runs the in-memory demo store in a production build. Local testing only:
# on serverless, invitations will appear and vanish between requests.
# ALLOW_DEMO_IN_PRODUCTION=1
